{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didactic-octo-spoon",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    // React Router (BrowserRouter) braucht clientseitiges Routing: unbekannte Pfade wie
    // /blog/mein-artikel müssen trotzdem index.html ausliefern, nicht 404.
    "not_found_handling": "single-page-application"
  }
}
